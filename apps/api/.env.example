# Copy to .env for local development. Without DATABASE_URL the API serves the built-in demo state.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/apex
LEDGER_OWNER=demo

# Peppers stored OTP hashes. Any long random string; a development default is used when unset.
AUTH_SECRET=

# Browser origin allowed to call the API. Defaults to * for the public demo.
ALLOWED_ORIGIN=*

# SMS delivery. Leave SMS_PROVIDER empty to keep returning devCode in the sign-in response.
SMS_PROVIDER=
TERMII_API_KEY=
TERMII_SENDER_ID=N-Alert

# Paystack test-mode keys. Card funding stays switched off (503 payments_not_configured) until set.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Where Paystack sends the payer after checkout; the app opens the wallet when it matches its own origin.
PAYMENT_RETURN_URL=
