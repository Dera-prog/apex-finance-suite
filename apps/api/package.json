{
  "name": "@apex/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --import tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:init": "node --import tsx scripts/pg.ts init",
    "db:up": "node --import tsx scripts/pg.ts start",
    "db:down": "node --import tsx scripts/pg.ts stop",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node --import tsx scripts/seed.ts",
    "db:seed-if-empty": "node --import tsx scripts/seed-if-empty.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.21.0"
  }
}
