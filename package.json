{
  "name": "apex-finance-suite",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:case": "npm run dev -w @apex/case-study",
    "dev:site": "npm run dev -w @apex/website",
    "dev:desktop": "npm run dev -w @apex/desktop",
    "dev:mobile": "npm run dev -w @apex/mobile",
    "build": "npm run build -w @apex/case-study && npm run build -w @apex/website && npm run build -w @apex/desktop && npm run build -w @apex/mobile",
    "build:case": "npm run build -w @apex/case-study",
    "build:site": "npm run build -w @apex/website",
    "build:desktop": "npm run build -w @apex/desktop",
    "build:mobile": "npm run build -w @apex/mobile"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/sora": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "lucide-react": "^0.548.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
